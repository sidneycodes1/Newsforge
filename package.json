{
  "name": "newsforge",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build && npm run build:agent",
    "start": "next start frontend",
    "build:agent": "tsc --project tsconfig.agent.json",
    "agent": "node agent/dist/runtime/runner.js",
    "type-check": "tsc --noEmit",
    "lint": "next lint frontend",
    "typecheck": "tsc --noEmit",
    "fix-covers": "npx tsx scripts/maintenance/fix-old-covers.ts",
    "test:ace": "npx tsx scripts/validation/test-ace.ts",
    "register": "echo SAP registration disabled. See scripts/setup/register-agent.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.16.0",
    "next": "^14.2.0",
    "node-cron": "^3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.5",
    "uuid": "^10.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
